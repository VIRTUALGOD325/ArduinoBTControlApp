<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0D0D0D">

    <!-- Toolbar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:background="#161616">

        <ImageView
            android:id="@+id/backBtn"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_menu_revert"
            android:layout_marginEnd="16dp"
            app:tint="#9ECAFF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚙️  Settings"
            android:textColor="#E5E2E1"
            android:textSize="18sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- ─── Button Labels Section ─── -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BUTTON LABELS &amp; COMMANDS"
                android:textColor="#9ECAFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="10dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_dark"
                android:padding="16dp"
                android:layout_marginBottom="20dp">

                <!-- Row header -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">
                    <TextView android:layout_width="36dp" android:layout_height="wrap_content" android:text="BTN" android:textColor="#6B7280" android:textSize="10sp"/>
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="LABEL" android:textColor="#6B7280" android:textSize="10sp" android:layout_marginStart="8dp"/>
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="COMMAND" android:textColor="#6B7280" android:textSize="10sp" android:layout_marginStart="8dp"/>
                </LinearLayout>

                <!-- Button A -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="12dp">
                    <TextView android:layout_width="36dp" android:layout_height="wrap_content" android:text="A" android:textColor="#9ECAFF" android:textSize="16sp" android:textStyle="bold"/>
                    <EditText android:id="@+id/labelA" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:background="@drawable/input_bg" android:textColor="#E5E2E1" android:textSize="14sp" android:paddingHorizontal="12dp" android:layout_marginStart="8dp"/>
                    <EditText android:id="@+id/cmdA" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:background="@drawable/input_bg" android:textColor="#9ECAFF" android:textSize="14sp" android:fontFamily="monospace" android:paddingHorizontal="12dp" android:layout_marginStart="8dp"/>
                </LinearLayout>

                <!-- Button B -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="12dp">
                    <TextView android:layout_width="36dp" android:layout_height="wrap_content" android:text="B" android:textColor="#9ECAFF" android:textSize="16sp" android:textStyle="bold"/>
                    <EditText android:id="@+id/labelB" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:background="@drawable/input_bg" android:textColor="#E5E2E1" android:textSize="14sp" android:paddingHorizontal="12dp" android:layout_marginStart="8dp"/>
                    <EditText android:id="@+id/cmdB" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:background="@drawable/input_bg" android:textColor="#9ECAFF" android:textSize="14sp" android:fontFamily="monospace" android:paddingHorizontal="12dp" android:layout_marginStart="8dp"/>
                </LinearLayout>

                <!-- Button C -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="12dp">
                    <TextView android:layout_width="36dp" android:layout_height="wrap_content" android:text="C" android:textColor="#9ECAFF" android:textSize="16sp" android:textStyle="bold"/>
                    <EditText android:id="@+id/labelC" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:background="@drawable/input_bg" android:textColor="#E5E2E1" android:textSize="14sp" android:paddingHorizontal="12dp" android:layout_marginStart="8dp"/>
                    <EditText android:id="@+id/cmdC" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:background="@drawable/input_bg" android:textColor="#9ECAFF" android:textSize="14sp" android:fontFamily="monospace" android:paddingHorizontal="12dp" android:layout_marginStart="8dp"/>
                </LinearLayout>

                <!-- Button D -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                    <TextView android:layout_width="36dp" android:layout_height="wrap_content" android:text="D" android:textColor="#9ECAFF" android:textSize="16sp" android:textStyle="bold"/>
                    <EditText android:id="@+id/labelD" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:background="@drawable/input_bg" android:textColor="#E5E2E1" android:textSize="14sp" android:paddingHorizontal="12dp" android:layout_marginStart="8dp"/>
                    <EditText android:id="@+id/cmdD" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:background="@drawable/input_bg" android:textColor="#9ECAFF" android:textSize="14sp" android:fontFamily="monospace" android:paddingHorizontal="12dp" android:layout_marginStart="8dp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- ─── D-Pad Commands Section ─── -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="D-PAD COMMANDS"
                android:textColor="#9ECAFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="10dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_dark"
                android:padding="16dp"
                android:layout_marginBottom="20dp">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="6dp">
                    <TextView android:layout_width="90dp" android:layout_height="wrap_content" android:text="DIRECTION" android:textColor="#6B7280" android:textSize="10sp"/>
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="COMMAND" android:textColor="#6B7280" android:textSize="10sp" android:layout_marginStart="8dp"/>
                    <TextView android:layout_width="64dp" android:layout_height="wrap_content" android:text="NO STOP" android:textColor="#6B7280" android:textSize="10sp" android:gravity="center"/>
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="12dp">
                    <TextView android:layout_width="90dp" android:layout_height="wrap_content" android:text="▲  Forward" android:textColor="#E5E2E1" android:textSize="14sp"/>
                    <EditText android:id="@+id/cmdForward" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:background="@drawable/input_bg" android:textColor="#9ECAFF" android:textSize="14sp" android:fontFamily="monospace" android:paddingHorizontal="12dp" android:layout_marginStart="8dp" android:inputType="text"/>
                    <CheckBox android:id="@+id/noStopForward" android:layout_width="64dp" android:layout_height="wrap_content" android:gravity="center" android:buttonTint="#9ECAFF"/>
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="12dp">
                    <TextView android:layout_width="90dp" android:layout_height="wrap_content" android:text="▼  Back" android:textColor="#E5E2E1" android:textSize="14sp"/>
                    <EditText android:id="@+id/cmdBack" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:background="@drawable/input_bg" android:textColor="#9ECAFF" android:textSize="14sp" android:fontFamily="monospace" android:paddingHorizontal="12dp" android:layout_marginStart="8dp" android:inputType="text"/>
                    <CheckBox android:id="@+id/noStopBack" android:layout_width="64dp" android:layout_height="wrap_content" android:gravity="center" android:buttonTint="#9ECAFF"/>
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="12dp">
                    <TextView android:layout_width="90dp" android:layout_height="wrap_content" android:text="◀  Left" android:textColor="#E5E2E1" android:textSize="14sp"/>
                    <EditText android:id="@+id/cmdLeft" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:background="@drawable/input_bg" android:textColor="#9ECAFF" android:textSize="14sp" android:fontFamily="monospace" android:paddingHorizontal="12dp" android:layout_marginStart="8dp" android:inputType="text"/>
                    <CheckBox android:id="@+id/noStopLeft" android:layout_width="64dp" android:layout_height="wrap_content" android:gravity="center" android:buttonTint="#9ECAFF"/>
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="12dp">
                    <TextView android:layout_width="90dp" android:layout_height="wrap_content" android:text="▶  Right" android:textColor="#E5E2E1" android:textSize="14sp"/>
                    <EditText android:id="@+id/cmdRight" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:background="@drawable/input_bg" android:textColor="#9ECAFF" android:textSize="14sp" android:fontFamily="monospace" android:paddingHorizontal="12dp" android:layout_marginStart="8dp" android:inputType="text"/>
                    <CheckBox android:id="@+id/noStopRight" android:layout_width="64dp" android:layout_height="wrap_content" android:gravity="center" android:buttonTint="#9ECAFF"/>
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                    <TextView android:layout_width="90dp" android:layout_height="wrap_content" android:text="⏹  Stop" android:textColor="#E5E2E1" android:textSize="14sp"/>
                    <EditText android:id="@+id/cmdStop" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:background="@drawable/input_bg" android:textColor="#9ECAFF" android:textSize="14sp" android:fontFamily="monospace" android:paddingHorizontal="12dp" android:layout_marginStart="8dp" android:inputType="text"/>
                </LinearLayout>
            </LinearLayout>

            <!-- ─── Joystick Quadrant Commands ─── -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="JOYSTICK COMMANDS"
                android:textColor="#A8FF78"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="10dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_dark"
                android:padding="16dp"
                android:layout_marginBottom="20dp">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="6dp">
                    <TextView android:layout_width="100dp" android:layout_height="wrap_content" android:text="QUADRANT" android:textColor="#6B7280" android:textSize="10sp"/>
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="COMMAND" android:textColor="#6B7280" android:textSize="10sp" android:layout_marginStart="8dp"/>
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="10dp">
                    <TextView android:layout_width="100dp" android:layout_height="wrap_content" android:text="↑  Up" android:textColor="#E5E2E1" android:textSize="13sp"/>
                    <EditText android:id="@+id/joyUp" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:background="@drawable/input_bg" android:textColor="#A8FF78" android:textSize="13sp" android:fontFamily="monospace" android:paddingHorizontal="12dp" android:layout_marginStart="8dp" android:inputType="text"/>
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="10dp">
                    <TextView android:layout_width="100dp" android:layout_height="wrap_content" android:text="↓  Down" android:textColor="#E5E2E1" android:textSize="13sp"/>
                    <EditText android:id="@+id/joyDown" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:background="@drawable/input_bg" android:textColor="#A8FF78" android:textSize="13sp" android:fontFamily="monospace" android:paddingHorizontal="12dp" android:layout_marginStart="8dp" android:inputType="text"/>
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="10dp">
                    <TextView android:layout_width="100dp" android:layout_height="wrap_content" android:text="←  Left" android:textColor="#E5E2E1" android:textSize="13sp"/>
                    <EditText android:id="@+id/joyLeft" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:background="@drawable/input_bg" android:textColor="#A8FF78" android:textSize="13sp" android:fontFamily="monospace" android:paddingHorizontal="12dp" android:layout_marginStart="8dp" android:inputType="text"/>
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="10dp">
                    <TextView android:layout_width="100dp" android:layout_height="wrap_content" android:text="→  Right" android:textColor="#E5E2E1" android:textSize="13sp"/>
                    <EditText android:id="@+id/joyRight" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:background="@drawable/input_bg" android:textColor="#A8FF78" android:textSize="13sp" android:fontFamily="monospace" android:paddingHorizontal="12dp" android:layout_marginStart="8dp" android:inputType="text"/>
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="10dp">
                    <TextView android:layout_width="100dp" android:layout_height="wrap_content" android:text="⏹  Stop" android:textColor="#E5E2E1" android:textSize="13sp"/>
                    <EditText android:id="@+id/joyStop" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:background="@drawable/input_bg" android:textColor="#A8FF78" android:textSize="13sp" android:fontFamily="monospace" android:paddingHorizontal="12dp" android:layout_marginStart="8dp" android:inputType="text"/>
                </LinearLayout>

                <!-- Diagonal divider -->
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#2A2A3A" android:layout_marginBottom="10dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="DIAGONALS" android:textColor="#6B7280" android:textSize="10sp" android:layout_marginBottom="8dp"/>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="10dp">
                    <TextView android:layout_width="100dp" android:layout_height="wrap_content" android:text="↗  Up-Right" android:textColor="#E5E2E1" android:textSize="13sp"/>
                    <EditText android:id="@+id/joyUR" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:background="@drawable/input_bg" android:textColor="#A8FF78" android:textSize="13sp" android:fontFamily="monospace" android:paddingHorizontal="12dp" android:layout_marginStart="8dp" android:inputType="text"/>
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="10dp">
                    <TextView android:layout_width="100dp" android:layout_height="wrap_content" android:text="↖  Up-Left" android:textColor="#E5E2E1" android:textSize="13sp"/>
                    <EditText android:id="@+id/joyUL" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:background="@drawable/input_bg" android:textColor="#A8FF78" android:textSize="13sp" android:fontFamily="monospace" android:paddingHorizontal="12dp" android:layout_marginStart="8dp" android:inputType="text"/>
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="10dp">
                    <TextView android:layout_width="100dp" android:layout_height="wrap_content" android:text="↘  Down-Right" android:textColor="#E5E2E1" android:textSize="13sp"/>
                    <EditText android:id="@+id/joyDR" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:background="@drawable/input_bg" android:textColor="#A8FF78" android:textSize="13sp" android:fontFamily="monospace" android:paddingHorizontal="12dp" android:layout_marginStart="8dp" android:inputType="text"/>
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                    <TextView android:layout_width="100dp" android:layout_height="wrap_content" android:text="↙  Down-Left" android:textColor="#E5E2E1" android:textSize="13sp"/>
                    <EditText android:id="@+id/joyDL" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:background="@drawable/input_bg" android:textColor="#A8FF78" android:textSize="13sp" android:fontFamily="monospace" android:paddingHorizontal="12dp" android:layout_marginStart="8dp" android:inputType="text"/>
                </LinearLayout>
            </LinearLayout>

            <!-- ─── Numpad Commands (collapsible) ─── -->
            <LinearLayout
                android:id="@+id/numpadHeader"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:orientation="horizontal"
                android:background="@drawable/bg_card_dark"
                android:paddingHorizontal="16dp"
                android:gravity="center_vertical"
                android:layout_marginBottom="4dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="NUMPAD COMMANDS"
                    android:textColor="#FFD700"
                    android:textSize="12sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/numpadArrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="▼"
                    android:textColor="#89919D"
                    android:textSize="11sp"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/numpadBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_dark"
                android:paddingHorizontal="16dp"
                android:paddingBottom="16dp"
                android:paddingTop="4dp"
                android:visibility="gone"
                android:layout_marginBottom="20dp">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="10dp" android:layout_marginBottom="6dp">
                    <TextView android:layout_width="56dp" android:layout_height="wrap_content" android:text="KEY" android:textColor="#6B7280" android:textSize="10sp"/>
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="COMMAND SENT" android:textColor="#6B7280" android:textSize="10sp" android:layout_marginStart="8dp"/>
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="8dp">
                    <TextView android:layout_width="56dp" android:layout_height="wrap_content" android:text="0" android:textColor="#FFD700" android:textSize="16sp" android:textStyle="bold"/>
                    <EditText android:id="@+id/numCmd0" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:background="@drawable/input_bg" android:textColor="#FFD700" android:textSize="13sp" android:fontFamily="monospace" android:paddingHorizontal="12dp" android:layout_marginStart="8dp" android:inputType="text"/>
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="8dp">
                    <TextView android:layout_width="56dp" android:layout_height="wrap_content" android:text="1" android:textColor="#FFD700" android:textSize="16sp" android:textStyle="bold"/>
                    <EditText android:id="@+id/numCmd1" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:background="@drawable/input_bg" android:textColor="#FFD700" android:textSize="13sp" android:fontFamily="monospace" android:paddingHorizontal="12dp" android:layout_marginStart="8dp" android:inputType="text"/>
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="8dp">
                    <TextView android:layout_width="56dp" android:layout_height="wrap_content" android:text="2" android:textColor="#FFD700" android:textSize="16sp" android:textStyle="bold"/>
                    <EditText android:id="@+id/numCmd2" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:background="@drawable/input_bg" android:textColor="#FFD700" android:textSize="13sp" android:fontFamily="monospace" android:paddingHorizontal="12dp" android:layout_marginStart="8dp" android:inputType="text"/>
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="8dp">
                    <TextView android:layout_width="56dp" android:layout_height="wrap_content" android:text="3" android:textColor="#FFD700" android:textSize="16sp" android:textStyle="bold"/>
                    <EditText android:id="@+id/numCmd3" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:background="@drawable/input_bg" android:textColor="#FFD700" android:textSize="13sp" android:fontFamily="monospace" android:paddingHorizontal="12dp" android:layout_marginStart="8dp" android:inputType="text"/>
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="8dp">
                    <TextView android:layout_width="56dp" android:layout_height="wrap_content" android:text="4" android:textColor="#FFD700" android:textSize="16sp" android:textStyle="bold"/>
                    <EditText android:id="@+id/numCmd4" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:background="@drawable/input_bg" android:textColor="#FFD700" android:textSize="13sp" android:fontFamily="monospace" android:paddingHorizontal="12dp" android:layout_marginStart="8dp" android:inputType="text"/>
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="8dp">
                    <TextView android:layout_width="56dp" android:layout_height="wrap_content" android:text="5" android:textColor="#FFD700" android:textSize="16sp" android:textStyle="bold"/>
                    <EditText android:id="@+id/numCmd5" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:background="@drawable/input_bg" android:textColor="#FFD700" android:textSize="13sp" android:fontFamily="monospace" android:paddingHorizontal="12dp" android:layout_marginStart="8dp" android:inputType="text"/>
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="8dp">
                    <TextView android:layout_width="56dp" android:layout_height="wrap_content" android:text="6" android:textColor="#FFD700" android:textSize="16sp" android:textStyle="bold"/>
                    <EditText android:id="@+id/numCmd6" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:background="@drawable/input_bg" android:textColor="#FFD700" android:textSize="13sp" android:fontFamily="monospace" android:paddingHorizontal="12dp" android:layout_marginStart="8dp" android:inputType="text"/>
