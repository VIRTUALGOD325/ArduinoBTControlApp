<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D0D0D">

    <!-- Camera preview fills from top to above bottom panel -->
    <androidx.camera.view.PreviewView
        android:id="@+id/cameraPreview"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomPanel"
        app:layout_constraintHeight_min="140dp"/>

    <!-- Detection overlay on top of camera -->
    <com.eduprime.arduinobt.views.DetectionOverlayView
        android:id="@+id/detectionOverlay"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomPanel"/>

    <!-- ── Top status bar (overlaid on camera) ── -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:background="#CC000000"
        android:paddingHorizontal="16dp"
        android:gravity="center_vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <View
            android:id="@+id/btStatusDot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="@drawable/circle_red"/>

        <TextView
            android:id="@+id/btStatusText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Not Connected"
            android:textColor="#E5E2E1"
            android:textSize="13sp"/>

        <TextView
            android:id="@+id/modeLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="👁️ Scanning..."
            android:textColor="#A8FF78"
            android:textSize="12sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <!-- ── Mode tabs (overlaid below top bar) ── -->
    <LinearLayout
        android:id="@+id/modeTabs"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp"
        android:gravity="center"
        android:background="#BB000000"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tabDetect"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:gravity="center"
            android:text="🔍 DETECT"
            android:textColor="#A8FF78"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="@drawable/bg_button_green"/>

        <TextView
            android:id="@+id/tabTrack"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:gravity="center"
            android:text="🎯 TRACK"
            android:textColor="#FFD700"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="@drawable/bg_button_yellow"/>

        <TextView
            android:id="@+id/tabTrain"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="🎓 TEACH"
            android:textColor="#FF9EC4"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="@drawable/bg_button_pink"/>
    </LinearLayout>

    <!-- ── Bottom content panel (sticks above bottom nav, scrollable) ── -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/bottomPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#111111"
        app:layout_constraintBottom_toTopOf="@id/bottomActionBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="14dp"
            android:paddingTop="14dp"
            android:paddingBottom="6dp">

            <!-- ═══════════════════════════════════════
                 DETECT / TRACK PANEL
                 ═══════════════════════════════════════ -->
            <LinearLayout
                android:id="@+id/detectTrackPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Detection result card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card_dark"
                    android:padding="16dp"
                    android:layout_marginBottom="8dp">

                    <!-- Anim + label + command badge -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <FrameLayout
                            android:layout_width="40dp"
                            android:layout_height="40dp">

                            <com.airbnb.lottie.LottieAnimationView
                                android:id="@+id/animScanning"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                app:lottie_fileName="anim_scanning.json"
                                app:lottie_autoPlay="true"
                                app:lottie_loop="true"/>

                            <com.airbnb.lottie.LottieAnimationView
                                android:id="@+id/animDetected"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:visibility="gone"
                                app:lottie_fileName="anim_detected.json"
                                app:lottie_autoPlay="false"
                                app:lottie_loop="false"/>
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="14dp">

                            <TextView
                                android:id="@+id/detectedName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Nothing detected yet"
                                android:textColor="#E5E2E1"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:maxLines="1"
                                android:ellipsize="end"/>

                            <TextView
                                android:id="@+id/detectedConf"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:text="Point camera at something!"
                                android:textColor="#89919D"
                                android:textSize="12sp"
                                android:maxLines="1"
                                android:ellipsize="end"/>
                        </LinearLayout>

                        <!-- Command badge -->
                        <TextView
                            android:id="@+id/detectedCommand"
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            android:gravity="center"
                            android:text="--"
                            android:textColor="#9ECAFF"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            android:background="@drawable/bg_card_dark"
                            android:layout_marginStart="12dp"/>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#1AFFFFFF"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="10dp"/>

                    <!-- Auto-Drive row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="🚗  Auto-Drive"
                            android:textColor="#E5E2E1"
                            android:textSize="14sp"
                            android:textStyle="bold"/>

                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/autoDriveSwitch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>
                </LinearLayout>

                <!-- ML Parameters header -->
                <LinearLayout
                    android:id="@+id/mlParamsHeader"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_card_dark"
                    android:paddingHorizontal="16dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="⚙️  ML Parameters"
                        android:textColor="#E5E2E1"
                        android:textSize="13sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/mlParamsArrow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="▼"
                        android:textColor="#89919D"
                        android:textSize="12sp"/>
                </LinearLayout>

                <!-- ML Parameters body (collapsed by default) -->
                <LinearLayout
                    android:id="@+id/mlParamsBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card_dark"
                    android:paddingHorizontal="16dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="16dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Detection Confidence"
                        android:textColor="#9ECAFF"
                        android:textSize="11sp"
                        android:textStyle="bold"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="4dp">

                        <SeekBar
                            android:id="@+id/seekConfidence"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:max="100"
                            android:progress="0"
                            android:progressTint="#9ECAFF"
                            android:thumbTint="#9ECAFF"/>

                        <TextView
                            android:id="@+id/tvConfidenceValue"
                            android:layout_width="36dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="0%"
                            android:textColor="#9ECAFF"
                            android:textSize="11sp"
                            android:gravity="end"/>
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="Match Threshold"
                        android:textColor="#A8FF78"
                        android:textSize="11sp"
                        android:textStyle="bold"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="4dp">

                        <SeekBar
                            android:id="@+id/seekMatchThreshold"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:max="100"
                            android:progress="15"
                            android:progressTint="#A8FF78"
                            android:thumbTint="#A8FF78"/>

                        <TextView
                            android:id="@+id/tvMatchThresholdValue"
                            android:layout_width="36dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="15%"
                            android:textColor="#A8FF78"
                            android:textSize="11sp"
                            android:gravity="end"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- ═══════════════════════════════════════
                 TEACH PANEL  (hidden in detect/track modes)
                 ═══════════════════════════════════════ -->
            <LinearLayout
                android:id="@+id/teachPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Selected class info + command input -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_card_dark"
                    android:padding="14dp"
                    android:layout_marginBottom="8dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/teachClassName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="No class selected"
                            android:textColor="#E5E2E1"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:maxLines="1"
                            android:ellipsize="end"/>

                        <TextView
                            android:id="@+id/teachSampleCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="Tap a class below to select"
                            android:textColor="#89919D"
                            android:textSize="12sp"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:layout_marginStart="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="COMMAND"
                            android:textColor="#89919D"
                            android:textSize="9sp"
                            android:letterSpacing="0.05"/>

                        <EditText
                            android:id="@+id/teachCommandInput"
                            android:layout_width="60dp"
                            android:layout_height="36dp"
                            android:gravity="center"
                            android:hint="F"
                            android:textColor="#9ECAFF"
                            android:textColorHint="#2A3040"
                            android:textSize="17sp"
                            android:textStyle="bold"
                            android:background="@drawable/bg_card_dark"
                            android:inputType="text"
                            android:maxLength="8"
                            android:padding="4dp"
                            android:layout_marginTop="4dp"/>
                    </LinearLayout>
                </LinearLayout>

                <!-- Class chips (horizontal RecyclerView) -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/classList"
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    android:layout_marginBottom="8dp"
                    android:clipToPadding="false"/>

                <!-- Add class + Capture row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="6dp">

                    <TextView
                        android:id="@+id/btnAddClass"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:gravity="center"
                        android:text="➕ Add Class"
                        android:textColor="#FF9EC4"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_button_pink"/>

                    <TextView
                        android:id="@+id/btnCapture"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_weight="1.6"
                        android:gravity="center"
                        android:text="📸  CAPTURE"
                        android:textColor="#A8FF78"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_button_green"/>
                </LinearLayout>

                <!-- Export + Import row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btnExport"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:gravity="center"
                        android:text="📤 Export Model"
                        android:textColor="#FFD700"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_button_yellow"/>

                    <TextView
                        android:id="@+id/btnImport"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="📥 Import Model"
                        android:textColor="#9ECAFF"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_card_dark"/>
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ── Bottom action bar ── -->
    <LinearLayout
        android:id="@+id/bottomActionBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:background="#111111"
        android:paddingHorizontal="14dp"
        android:paddingVertical="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/btnNavBack"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:gravity="center"
            android:text="← Connection"
            android:textColor="#9ECAFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:background="@drawable/bg_card_dark"/>

        <TextView
            android:id="@+id/btnNavSettings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="⚙️ Settings"
            android:textColor="#89919D"
            android:textSize="13sp"
            android:textStyle="bold"
            android:background="@drawable/bg_card_dark"/>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
