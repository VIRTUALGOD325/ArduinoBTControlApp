<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0D0D0D">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/backBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="← Back"
            android:textColor="#9ECAFF"
            android:textSize="14sp"
            android:padding="4dp"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Button Settings"
            android:textColor="#E5E2E1"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center"/>

        <TextView
            android:id="@+id/resetBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Reset"
            android:textColor="#6B7280"
            android:textSize="13sp"
            android:padding="4dp"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingBottom="16dp">

            <!-- Info -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Configure the command string sent to Firebase when each button is pressed."
                android:textColor="#4A5568"
                android:textSize="12sp"
                android:lineSpacingExtra="3dp"
                android:layout_marginBottom="20dp"/>

            <!-- DIRECTIONAL section -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="DIRECTIONAL"
                android:textColor="#9ECAFF"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.15"
                android:layout_marginBottom="10dp"/>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardBackgroundColor="#141B24"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="4dp">

                    <!-- UP -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="16dp">
                        <TextView android:layout_width="60dp" android:layout_height="wrap_content" android:text="▲  UP" android:textColor="#9ECAFF" android:textSize="13sp" android:textStyle="bold"/>
                        <View android:layout_width="1dp" android:layout_height="24dp" android:background="#1E2A38" android:layout_marginEnd="12dp"/>
                        <EditText android:id="@+id/cmdUp" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="@null" android:textColor="#E5E2E1" android:textSize="14sp" android:fontFamily="monospace" android:hint="command" android:textColorHint="#4A5568" android:singleLine="true"/>
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#1A2230" android:layout_marginHorizontal="16dp"/>

                    <!-- DOWN -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="16dp">
                        <TextView android:layout_width="60dp" android:layout_height="wrap_content" android:text="▼  DOWN" android:textColor="#9ECAFF" android:textSize="13sp" android:textStyle="bold"/>
                        <View android:layout_width="1dp" android:layout_height="24dp" android:background="#1E2A38" android:layout_marginEnd="12dp"/>
                        <EditText android:id="@+id/cmdDown" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="@null" android:textColor="#E5E2E1" android:textSize="14sp" android:fontFamily="monospace" android:hint="command" android:textColorHint="#4A5568" android:singleLine="true"/>
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#1A2230" android:layout_marginHorizontal="16dp"/>

                    <!-- LEFT -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="16dp">
                        <TextView android:layout_width="60dp" android:layout_height="wrap_content" android:text="◀  LEFT" android:textColor="#9ECAFF" android:textSize="13sp" android:textStyle="bold"/>
                        <View android:layout_width="1dp" android:layout_height="24dp" android:background="#1E2A38" android:layout_marginEnd="12dp"/>
                        <EditText android:id="@+id/cmdLeft" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="@null" android:textColor="#E5E2E1" android:textSize="14sp" android:fontFamily="monospace" android:hint="command" android:textColorHint="#4A5568" android:singleLine="true"/>
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#1A2230" android:layout_marginHorizontal="16dp"/>

                    <!-- RIGHT -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="16dp">
                        <TextView android:layout_width="60dp" android:layout_height="wrap_content" android:text="▶  RIGHT" android:textColor="#9ECAFF" android:textSize="13sp" android:textStyle="bold"/>
                        <View android:layout_width="1dp" android:layout_height="24dp" android:background="#1E2A38" android:layout_marginEnd="12dp"/>
                        <EditText android:id="@+id/cmdRight" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="@null" android:textColor="#E5E2E1" android:textSize="14sp" android:fontFamily="monospace" android:hint="command" android:textColorHint="#4A5568" android:singleLine="true"/>
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#1A2230" android:layout_marginHorizontal="16dp"/>

                    <!-- STOP -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="16dp">
                        <TextView android:layout_width="60dp" android:layout_height="wrap_content" android:text="■  STOP" android:textColor="#FF5252" android:textSize="13sp" android:textStyle="bold"/>
                        <View android:layout_width="1dp" android:layout_height="24dp" android:background="#1E2A38" android:layout_marginEnd="12dp"/>
                        <EditText android:id="@+id/cmdStop" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="@null" android:textColor="#E5E2E1" android:textSize="14sp" android:fontFamily="monospace" android:hint="command" android:textColorHint="#4A5568" android:singleLine="true"/>
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- NUMBER BUTTONS section -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="NUMBER BUTTONS"
                android:textColor="#9ECAFF"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.15"
                android:layout_marginBottom="10dp"/>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardBackgroundColor="#141B24"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="4dp">

                    <!-- 1 -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="16dp">
                        <TextView android:layout_width="40dp" android:layout_height="wrap_content" android:text="1" android:textColor="#9ECAFF" android:textSize="16sp" android:textStyle="bold"/>
                        <View android:layout_width="1dp" android:layout_height="24dp" android:background="#1E2A38" android:layout_marginEnd="12dp"/>
                        <EditText android:id="@+id/cmd1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="@null" android:textColor="#E5E2E1" android:textSize="14sp" android:fontFamily="monospace" android:hint="command" android:textColorHint="#4A5568" android:singleLine="true"/>
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#1A2230" android:layout_marginHorizontal="16dp"/>

                    <!-- 2 -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="16dp">
                        <TextView android:layout_width="40dp" android:layout_height="wrap_content" android:text="2" android:textColor="#9ECAFF" android:textSize="16sp" android:textStyle="bold"/>
                        <View android:layout_width="1dp" android:layout_height="24dp" android:background="#1E2A38" android:layout_marginEnd="12dp"/>
                        <EditText android:id="@+id/cmd2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="@null" android:textColor="#E5E2E1" android:textSize="14sp" android:fontFamily="monospace" android:hint="command" android:textColorHint="#4A5568" android:singleLine="true"/>
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#1A2230" android:layout_marginHorizontal="16dp"/>

                    <!-- 3 -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="16dp">
                        <TextView android:layout_width="40dp" android:layout_height="wrap_content" android:text="3" android:textColor="#9ECAFF" android:textSize="16sp" android:textStyle="bold"/>
                        <View android:layout_width="1dp" android:layout_height="24dp" android:background="#1E2A38" android:layout_marginEnd="12dp"/>
                        <EditText android:id="@+id/cmd3" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="@null" android:textColor="#E5E2E1" android:textSize="14sp" android:fontFamily="monospace" android:hint="command" android:textColorHint="#4A5568" android:singleLine="true"/>
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#1A2230" android:layout_marginHorizontal="16dp"/>

                    <!-- 4 -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="16dp">
                        <TextView android:layout_width="40dp" android:layout_height="wrap_content" android:text="4" android:textColor="#9ECAFF" android:textSize="16sp" android:textStyle="bold"/>
                        <View android:layout_width="1dp" android:layout_height="24dp" android:background="#1E2A38" android:layout_marginEnd="12dp"/>
                        <EditText android:id="@+id/cmd4" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="@null" android:textColor="#E5E2E1" android:textSize="14sp" android:fontFamily="monospace" android:hint="command" android:textColorHint="#4A5568" android:singleLine="true"/>
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#1A2230" android:layout_marginHorizontal="16dp"/>

                    <!-- 5 -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="16dp">
                        <TextView android:layout_width="40dp" android:layout_height="wrap_content" android:text="5" android:textColor="#9ECAFF" android:textSize="16sp" android:textStyle="bold"/>
                        <View android:layout_width="1dp" android:layout_height="24dp" android:background="#1E2A38" android:layout_marginEnd="12dp"/>
                        <EditText android:id="@+id/cmd5" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="@null" android:textColor="#E5E2E1" android:textSize="14sp" android:fontFamily="monospace" android:hint="command" android:textColorHint="#4A5568" android:singleLine="true"/>
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#1A2230" android:layout_marginHorizontal="16dp"/>

                    <!-- 6 -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="16dp">
                        <TextView android:layout_width="40dp" android:layout_height="wrap_content" android:text="6" android:textColor="#9ECAFF" android:textSize="16sp" android:textStyle="bold"/>
                        <View android:layout_width="1dp" android:layout_height="24dp" android:background="#1E2A38" android:layout_marginEnd="12dp"/>
                        <EditText android:id="@+id/cmd6" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="@null" android:textColor="#E5E2E1" android:textSize="14sp" android:fontFamily="monospace" android:hint="command" android:textColorHint="#4A5568" android:singleLine="true"/>
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#1A2230" android:layout_marginHorizontal="16dp"/>

                    <!-- 7 -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="16dp">
                        <TextView android:layout_width="40dp" android:layout_height="wrap_content" android:text="7" android:textColor="#9ECAFF" android:textSize="16sp" android:textStyle="bold"/>
                        <View android:layout_width="1dp" android:layout_height="24dp" android:background="#1E2A38" android:layout_marginEnd="12dp"/>
                        <EditText android:id="@+id/cmd7" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="@null" android:textColor="#E5E2E1" android:textSize="14sp" android:fontFamily="monospace" android:hint="command" android:textColorHint="#4A5568" android:singleLine="true"/>
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#1A2230" android:layout_marginHorizontal="16dp"/>

                    <!-- 8 -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="16dp">
                        <TextView android:layout_width="40dp" android:layout_height="wrap_content" android:text="8" android:textColor="#9ECAFF" android:textSize="16sp" android:textStyle="bold"/>
                        <View android:layout_width="1dp" android:layout_height="24dp" android:background="#1E2A38" android:layout_marginEnd="12dp"/>
                        <EditText android:id="@+id/cmd8" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="@null" android:textColor="#E5E2E1" android:textSize="14sp" android:fontFamily="monospace" android:hint="command" android:textColorHint="#4A5568" android:singleLine="true"/>
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#1A2230" android:layout_marginHorizontal="16dp"/>

                    <!-- 9 -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="16dp">
                        <TextView android:layout_width="40dp" android:layout_height="wrap_content" android:text="9" android:textColor="#9ECAFF" android:textSize="16sp" android:textStyle="bold"/>
                        <View android:layout_width="1dp" android:layout_height="24dp" android:background="#1E2A38" android:layout_marginEnd="12dp"/>
                        <EditText android:id="@+id/cmd9" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="@null" android:textColor="#E5E2E1" android:textSize="14sp" android:fontFamily="monospace" android:hint="command" android:textColorHint="#4A5568" android:singleLine="true"/>
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

    <!-- Save button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:background="#0D0D0D">

        <TextView
            android:id="@+id/saveBtn"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Save Settings"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:gravity="center"
            android:background="@drawable/btn_control_blue"/>
    </LinearLayout>

</LinearLayout>
