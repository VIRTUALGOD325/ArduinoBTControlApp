<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0D0D0D">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/backBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="← Back"
            android:textColor="#9ECAFF"
            android:textSize="14sp"
            android:padding="4dp"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Button Control"
            android:textColor="#E5E2E1"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center"/>

        <TextView
            android:id="@+id/settingsBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚙"
            android:textColor="#9ECAFF"
            android:textSize="20sp"
            android:padding="6dp"/>
    </LinearLayout>

    <!-- Status card -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="16dp"
        app:cardBackgroundColor="#141B24"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="12dp"
            android:gravity="center_vertical">

            <View
                android:id="@+id/statusDot"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:background="#4A5568"
                android:layout_marginEnd="10dp"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="SENDING"
                android:textColor="#6B7280"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.15"/>

            <TextView
                android:id="@+id/statusLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NONE"
                android:textColor="#E5E2E1"
                android:textSize="16sp"
                android:textStyle="bold"
                android:fontFamily="monospace"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Scrollable content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingBottom="24dp">

            <!-- D-PAD label -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="DIRECTIONAL"
                android:textColor="#9ECAFF"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.15"
                android:layout_marginHorizontal="20dp"
                android:layout_marginBottom="16dp"
                android:layout_marginTop="4dp"/>

            <!-- Up -->
            <TextView
                android:id="@+id/btnUp"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:text="▲"
                android:textColor="#FFFFFF"
                android:textSize="28sp"
                android:gravity="center"
                android:background="@drawable/btn_control_blue"
                android:layout_marginBottom="8dp"/>

            <!-- Middle row -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:id="@+id/btnLeft"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:text="◀"
                    android:textColor="#FFFFFF"
                    android:textSize="28sp"
                    android:gravity="center"
                    android:background="@drawable/btn_control_blue"
                    android:layout_marginEnd="10dp"/>

                <TextView
                    android:id="@+id/btnStop"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:text="■"
                    android:textColor="#FFFFFF"
                    android:textSize="28sp"
                    android:gravity="center"
                    android:background="@drawable/btn_control_red"
                    android:layout_marginEnd="10dp"/>

                <TextView
                    android:id="@+id/btnRight"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:text="▶"
                    android:textColor="#FFFFFF"
                    android:textSize="28sp"
                    android:gravity="center"
                    android:background="@drawable/btn_control_blue"/>
            </LinearLayout>

            <!-- Down -->
            <TextView
                android:id="@+id/btnDown"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:text="▼"
                android:textColor="#FFFFFF"
                android:textSize="28sp"
                android:gravity="center"
                android:background="@drawable/btn_control_blue"
                android:layout_marginBottom="28dp"/>

            <!-- NUMBER BUTTONS label -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="NUMBER BUTTONS"
                android:textColor="#9ECAFF"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.15"
                android:layout_marginHorizontal="20dp"
                android:layout_marginBottom="14dp"/>

            <!-- Row 1 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <TextView android:id="@+id/btn1" android:layout_width="70dp" android:layout_height="70dp" android:text="1" android:textColor="#9ECAFF" android:textSize="22sp" android:gravity="center" android:background="@drawable/btn_control_dark" android:layout_marginEnd="8dp"/>
                <TextView android:id="@+id/btn2" android:layout_width="70dp" android:layout_height="70dp" android:text="2" android:textColor="#9ECAFF" android:textSize="22sp" android:gravity="center" android:background="@drawable/btn_control_dark" android:layout_marginEnd="8dp"/>
                <TextView android:id="@+id/btn3" android:layout_width="70dp" android:layout_height="70dp" android:text="3" android:textColor="#9ECAFF" android:textSize="22sp" android:gravity="center" android:background="@drawable/btn_control_dark"/>
            </LinearLayout>

            <!-- Row 2 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <TextView android:id="@+id/btn4" android:layout_width="70dp" android:layout_height="70dp" android:text="4" android:textColor="#9ECAFF" android:textSize="22sp" android:gravity="center" android:background="@drawable/btn_control_dark" android:layout_marginEnd="8dp"/>
                <TextView android:id="@+id/btn5" android:layout_width="70dp" android:layout_height="70dp" android:text="5" android:textColor="#9ECAFF" android:textSize="22sp" android:gravity="center" android:background="@drawable/btn_control_dark" android:layout_marginEnd="8dp"/>
                <TextView android:id="@+id/btn6" android:layout_width="70dp" android:layout_height="70dp" android:text="6" android:textColor="#9ECAFF" android:textSize="22sp" android:gravity="center" android:background="@drawable/btn_control_dark"/>
            </LinearLayout>

            <!-- Row 3 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView android:id="@+id/btn7" android:layout_width="70dp" android:layout_height="70dp" android:text="7" android:textColor="#9ECAFF" android:textSize="22sp" android:gravity="center" android:background="@drawable/btn_control_dark" android:layout_marginEnd="8dp"/>
                <TextView android:id="@+id/btn8" android:layout_width="70dp" android:layout_height="70dp" android:text="8" android:textColor="#9ECAFF" android:textSize="22sp" android:gravity="center" android:background="@drawable/btn_control_dark" android:layout_marginEnd="8dp"/>
                <TextView android:id="@+id/btn9" android:layout_width="70dp" android:layout_height="70dp" android:text="9" android:textColor="#9ECAFF" android:textSize="22sp" android:gravity="center" android:background="@drawable/btn_control_dark"/>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
