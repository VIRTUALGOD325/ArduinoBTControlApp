<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D0D0D">

    <!-- Camera Preview View -->
    <androidx.camera.view.PreviewView
        android:id="@+id/cameraPreview"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomControlPanel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Translucent Header on top of Camera preview -->
    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:background="#99000000"
        android:padding="16dp"
        android:gravity="center_vertical"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/backBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="← Back"
            android:textColor="#9ECAFF"
            android:textSize="14sp"
            android:padding="4dp"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="IoT Camera Control"
            android:textColor="#E5E2E1"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center"/>

        <View
            android:layout_width="48dp"
            android:layout_height="1dp" />
    </LinearLayout>

    <!-- Bottom Control Panel -->
    <LinearLayout
        android:id="@+id/bottomControlPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#0D0D0D"
        android:padding="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Info / Status row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="CAMERA ACTIONS &amp; SERVO CONTROL"
                android:textColor="#6B7280"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"/>

            <TextView
                android:id="@+id/cameraStatusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ready"
                android:textColor="#A8FF78"
                android:textSize="11sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <!-- Dynamic split layout: Left side contains action triggers, Right side contains servo D-pad -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- Action buttons (Left side) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginEnd="8dp">

                <!-- Capture Remote button -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/captureRemoteCard"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginBottom="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardBackgroundColor="#141B24"
                    app:cardCornerRadius="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📸 Remote Capture"
                        android:textColor="#E5E2E1"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:layout_gravity="center"/>
                </androidx.cardview.widget.CardView>

                <!-- Flash Toggle Button -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/flashToggleCard"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginBottom="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardBackgroundColor="#141B24"
                    app:cardCornerRadius="8dp">

                    <TextView
                        android:id="@+id/flashText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="💡 Toggle Flash"
                        android:textColor="#E5E2E1"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:layout_gravity="center"/>
                </androidx.cardview.widget.CardView>

                <!-- Local Snapshot Button -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/captureLocalCard"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardBackgroundColor="#1F2E3D"
                    app:cardCornerRadius="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="💾 Phone Snapshot"
                        android:textColor="#9ECAFF"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:layout_gravity="center"/>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <!-- Servo D-pad layout (Right side) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="4dp"
                android:background="@drawable/bg_card_dark">

                <!-- Up Button -->
                <ImageButton
                    android:id="@+id/servoUpBtn"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@android:drawable/arrow_up_float"
                    android:contentDescription="Tilt Up"
                    app:tint="#9ECAFF"/>

                <!-- Middle row: Left, Center, Right -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <ImageButton
                        android:id="@+id/servoLeftBtn"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@android:drawable/arrow_down_float"
                        android:rotation="90"
                        android:contentDescription="Pan Left"
                        app:tint="#9ECAFF"/>

                    <!-- Reset / Center button -->
                    <TextView
                        android:id="@+id/servoCenterBtn"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:text="🔄"
                        android:textSize="16sp"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Center Servos"/>

                    <ImageButton
                        android:id="@+id/servoRightBtn"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@android:drawable/arrow_down_float"
                        android:rotation="270"
                        android:contentDescription="Pan Right"
                        app:tint="#9ECAFF"/>
                </LinearLayout>

                <!-- Down Button -->
                <ImageButton
                    android:id="@+id/servoDownBtn"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@android:drawable/arrow_down_float"
                    android:contentDescription="Tilt Down"
                    app:tint="#9ECAFF"/>
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
