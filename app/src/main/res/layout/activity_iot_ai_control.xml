<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D0D0D">

    <!-- Full-screen camera preview -->
    <androidx.camera.view.PreviewView
        android:id="@+id/cameraPreview"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/gradientFade"/>

    <!-- Detection overlay on top of camera -->
    <com.eduprime.arduinobt.views.DetectionOverlayView
        android:id="@+id/detectionOverlay"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/gradientFade"/>

    <!-- Gradient fade at the bottom of the camera view -->
    <View
        android:id="@+id/gradientFade"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:background="@drawable/bg_gradient_top"
        android:alpha="0.7"
        app:layout_constraintBottom_toTopOf="@id/bottomPanel"/>

    <!-- ── Top status bar ── -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:background="#CC000000"
        android:paddingHorizontal="16dp"
        android:gravity="center_vertical"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/backBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="← Back"
            android:textColor="#9ECAFF"
            android:textSize="14sp"
            android:padding="8dp"
            android:layout_marginEnd="8dp"/>

        <View
            android:id="@+id/iotStatusDot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="@drawable/circle_green"/>

        <TextView
            android:id="@+id/iotStatusText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="IoT Active"
            android:textColor="#E5E2E1"
            android:textSize="13sp"/>

        <TextView
            android:id="@+id/detectionLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="👁️ Scanning..."
            android:textColor="#A8FF78"
            android:textSize="12sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <!-- ── Mode tabs ── -->
    <LinearLayout
        android:id="@+id/modeTabs"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp"
        android:paddingVertical="6dp"
        android:gravity="center"
        android:background="#BB000000"
        app:layout_constraintTop_toBottomOf="@id/topBar">

        <TextView
            android:id="@+id/tabDetect"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:gravity="center"
            android:text="🔍 DETECT"
            android:textColor="#A8FF78"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="@drawable/bg_button_green"/>

        <TextView
            android:id="@+id/tabTrack"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:gravity="center"
            android:text="🎯 TRACK"
            android:textColor="#FFD700"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="@drawable/bg_button_yellow"/>

        <TextView
            android:id="@+id/tabTrain"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="🎓 TEACH"
            android:textColor="#FF9EC4"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="@drawable/bg_button_pink"/>
    </LinearLayout>

    <!-- ── Bottom panel ── -->
    <LinearLayout
        android:id="@+id/bottomPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#0D0D0D"
        android:paddingHorizontal="14dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Detection + Auto-Drive combined card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_dark"
            android:padding="14dp"
            android:layout_marginBottom="8dp">

            <!-- Row 1: animation + name/conf + command badge -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <FrameLayout
                    android:layout_width="36dp"
                    android:layout_height="36dp">

                    <com.airbnb.lottie.LottieAnimationView
                        android:id="@+id/animScanning"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        app:lottie_fileName="anim_scanning.json"
                        app:lottie_autoPlay="true"
                        app:lottie_loop="true"/>

                    <com.airbnb.lottie.LottieAnimationView
                        android:id="@+id/animDetected"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:visibility="gone"
                        app:lottie_fileName="anim_detected.json"
                        app:lottie_autoPlay="false"
                        app:lottie_loop="false"/>
                </FrameLayout>

                <!-- Name + confidence -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="12dp">

                    <TextView
                        android:id="@+id/detectedName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Nothing detected yet"
                        android:textColor="#E5E2E1"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:maxLines="1"
                        android:ellipsize="end"/>

                    <TextView
                        android:id="@+id/detectedConf"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Point camera at something!"
                        android:textColor="#89919D"
                        android:textSize="11sp"
                        android:maxLines="1"
                        android:ellipsize="end"/>
                </LinearLayout>

                <!-- Command badge -->
                <TextView
                    android:id="@+id/detectedCommand"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:gravity="center"
                    android:text="--"
                    android:textColor="#9ECAFF"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_card_dark"
                    android:layout_marginStart="10dp"/>
            </LinearLayout>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#1AFFFFFF"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="8dp"/>

            <!-- Row 2: Auto-Drive inline -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🚗  Auto-Drive to IoT DB"
                    android:textColor="#E5E2E1"
                    android:textSize="13sp"
                    android:textStyle="bold"/>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/autoDriveSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
        </LinearLayout>

        <!-- ML Parameters header (tap to expand) -->
        <LinearLayout
            android:id="@+id/mlParamsHeader"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:orientation="horizontal"
            android:background="@drawable/bg_card_dark"
            android:paddingHorizontal="16dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="⚙️  ML Parameters"
                android:textColor="#E5E2E1"
                android:textSize="13sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/mlParamsArrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="▼"
                android:textColor="#89919D"
                android:textSize="11sp"/>
        </LinearLayout>

        <!-- ML Parameters body (collapsed by default) -->
        <LinearLayout
            android:id="@+id/mlParamsBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_dark"
            android:paddingHorizontal="16dp"
            android:paddingBottom="14dp"
            android:paddingTop="4dp"
            android:visibility="gone">

            <!-- Detection Confidence -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Detection Confidence"
                android:textColor="#9ECAFF"
                android:textSize="11sp"
                android:textStyle="bold"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="4dp">

                <SeekBar
                    android:id="@+id/seekConfidence"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="100"
                    android:progress="0"
                    android:progressTint="#9ECAFF"
                    android:thumbTint="#9ECAFF"/>

                <TextView
                    android:id="@+id/tvConfidenceValue"
                    android:layout_width="32dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="0%"
                    android:textColor="#9ECAFF"
                    android:textSize="11sp"
                    android:gravity="end"/>
            </LinearLayout>

            <!-- Match Threshold -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Match Threshold"
                android:textColor="#A8FF78"
                android:textSize="11sp"
                android:textStyle="bold"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="4dp">

                <SeekBar
                    android:id="@+id/seekMatchThreshold"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="100"
                    android:progress="15"
                    android:progressTint="#A8FF78"
                    android:thumbTint="#A8FF78"/>

                <TextView
                    android:id="@+id/tvMatchThresholdValue"
                    android:layout_width="32dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="15%"
                    android:textColor="#A8FF78"
                    android:textSize="11sp"
                    android:gravity="end"/>
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
