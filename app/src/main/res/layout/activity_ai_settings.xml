<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0D0D0D">

    <!-- Top bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#111111"
        android:paddingHorizontal="16dp">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="←"
            android:textColor="#9ECAFF"
            android:textSize="22sp"
            android:padding="4dp"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:text="AI Lab Settings"
            android:textColor="#E5E2E1"
            android:textSize="18sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <!-- Scrollable content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- ═══ SECTION: Object → Command ═══ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🎯  Object Detection Commands"
                    android:textColor="#E5E2E1"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="What the robot sends when each object is detected"
                    android:textColor="#89919D"
                    android:textSize="12sp"
                    android:layout_marginBottom="12dp"/>

                <!-- Class rows injected here programmatically -->
                <LinearLayout
                    android:id="@+id/classListContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"/>

                <!-- Empty state (hidden when classes exist) -->
                <LinearLayout
                    android:id="@+id/emptyState"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/bg_card_dark"
                    android:padding="32dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🤖"
                        android:textSize="40sp"
                        android:gravity="center"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="No objects trained yet"
                        android:textColor="#E5E2E1"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:gravity="center"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Go to the AI Lab → Teach tab\nto train your first object"
                        android:textColor="#89919D"
                        android:textSize="12sp"
                        android:gravity="center"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#1AFFFFFF"
                android:layout_marginBottom="20dp"/>

            <!-- ═══ SECTION: Detection Tuning ═══ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_dark"
                android:padding="16dp"
                android:layout_marginBottom="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚙️  Detection Tuning"
                    android:textColor="#E5E2E1"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Adjust how strictly objects must match before a command is sent"
                    android:textColor="#89919D"
                    android:textSize="12sp"
                    android:layout_marginBottom="16dp"/>

                <!-- Detection Confidence -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="4dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Detection Confidence"
                        android:textColor="#9ECAFF"
                        android:textSize="12sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/tvConfidenceValue"
                        android:layout_width="36dp"
                        android:layout_height="wrap_content"
                        android:text="0%"
                        android:textColor="#9ECAFF"
                        android:textSize="12sp"
                        android:gravity="end"/>
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Minimum object detection score — raise to ignore uncertain detections"
                    android:textColor="#89919D"
                    android:textSize="11sp"
                    android:layout_marginBottom="6dp"/>

                <SeekBar
                    android:id="@+id/seekConfidence"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="100"
                    android:progressTint="#9ECAFF"
                    android:thumbTint="#9ECAFF"
                    android:layout_marginBottom="18dp"/>

                <!-- Match Threshold -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="4dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Match Threshold"
                        android:textColor="#A8FF78"
                        android:textSize="12sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/tvMatchValue"
                        android:layout_width="36dp"
                        android:layout_height="wrap_content"
                        android:text="15%"
                        android:textColor="#A8FF78"
                        android:textSize="12sp"
                        android:gravity="end"/>
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="How closely a live scene must match your training samples"
                    android:textColor="#89919D"
                    android:textSize="11sp"
                    android:layout_marginBottom="6dp"/>

                <SeekBar
                    android:id="@+id/seekMatch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="100"
                    android:progressTint="#A8FF78"
                    android:thumbTint="#A8FF78"
                    android:layout_marginBottom="18dp"/>

                <!-- Command Delay -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="4dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Command Repeat Delay"
                        android:textColor="#FFD700"
                        android:textSize="12sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/tvThrottleValue"
                        android:layout_width="52dp"
                        android:layout_height="wrap_content"
                        android:text="300 ms"
                        android:textColor="#FFD700"
                        android:textSize="12sp"
                        android:gravity="end"/>
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="How often the same command can be re-sent in Auto-Drive"
                    android:textColor="#89919D"
                    android:textSize="11sp"
                    android:layout_marginBottom="6dp"/>

                <!-- Range: 100ms–1000ms in 100ms steps → max=9 steps -->
                <SeekBar
                    android:id="@+id/seekThrottle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="9"
                    android:progress="2"
                    android:progressTint="#FFD700"
                    android:thumbTint="#FFD700"/>
            </LinearLayout>

            <!-- ═══ SECTION: Reset ═══ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_dark"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚠️  Danger Zone"
                    android:textColor="#FF6B6B"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Permanently delete all trained objects and their photos"
                    android:textColor="#89919D"
                    android:textSize="12sp"
                    android:layout_marginBottom="12dp"/>

                <TextView
                    android:id="@+id/btnClearAll"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:gravity="center"
                    android:text="🗑️  Clear All Training Data"
                    android:textColor="#FF6B6B"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_card_dark"/>
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="16dp"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
